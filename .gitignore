.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12

# Local application data, backups and logs.
/data/
/backups/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.log

# Dependencies, generated files and test artifacts.
/Worklog.exe
node_modules/
dist/
dist-demo/
build/
coverage/
.vite/
.vitest/
playwright-report/
test-results/
*.tsbuildinfo

# Editor and operating-system files.
.idea/
.DS_Store
Thumbs.db
~$*
