# Copy to .env on this computer; never commit .env or use VITE_ for secrets.
# Use the HTTPS base URL, including any installation subpath. No /login or /issues.
REDMINE_URL=
# Optional until authenticated access is tested. Enter your own API key locally.
REDMINE_API_KEY=
# Explicit exception for a known private server with an invalid certificate.
# Disables certificate validation only for this Redmine origin; HTTPS stays encrypted.
# Leave false unless you accept losing certificate-based server authentication.
REDMINE_ALLOW_INVALID_CERTIFICATE=false
# The local application continues to bind only to 127.0.0.1.
PORT=3000
