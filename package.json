{
  "name": "worklog-for-redmine",
  "version": "0.8.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts --dev",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "build:pages": "tsc --noEmit && vite build --mode demo --base=/worklog-for-redmine/",
    "check:demo": "node scripts/check-demo-build.mjs",
    "preview:demo": "vite preview --mode demo --host 127.0.0.1 --port 4173",
    "preview:pages": "vite preview --mode demo --base=/worklog-for-redmine/ --host 127.0.0.1 --port 4174",
    "start": "tsx src/server/index.ts",
    "launcher:build": "node scripts/build-launcher.mjs",
    "launcher:check": "node scripts/check-launcher.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
